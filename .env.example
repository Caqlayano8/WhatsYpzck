# WhatsYpzck CRM - Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# .env dosyasını asla Git'e commit ETMEYİN!

# ── Uygulama ──────────────────────────────────────────────────────────────────
PORT=54112
NODE_ENV=development
# NODE_ENV=production  (üretim için değiştirin)

# ── Güvenlik (ZO RUNLU — güçlü değer oluşturun) ───────────────────────────────
# Üretmek için: openssl rand -base64 32
JWT_SECRET=BURAYA_EN_AZ_32_KARAKTER_GUCLU_DEGER_KOYUN
JWT_EXPIRES_IN=2h

# Üretmek için: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=BURAYA_64_KARAKTER_HEX_DEGER_KOYUN

# ── Yönetici Hesabı ───────────────────────────────────────────────────────────
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=BURAYA_GUCLU_SIFRE_KOYUN

# ── Veritabanı ────────────────────────────────────────────────────────────────
# MongoDB:
MONGODB_URI=mongodb://localhost:27017/whatsypzck
# veya SQLite (varsayılan):
# DATABASE_URL=./data/whatsypzck.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production'da kendi domain'inizi yazın (virgülle ayırın):
ALLOWED_ORIGINS=http://localhost:19007,http://localhost:3000

# ── WhatsApp / Bot ────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=META_WHATSAPP_BUSINESS_API_TOKENI
WHATSAPP_PHONE_ID=META_TELEFON_ID
WEBHOOK_VERIFY_TOKEN=RASTGELE_GUVENLI_STRING_EN_AZ_20_KARAKTER

# ── E-posta (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@sirketiniz.com
SMTP_PASS=GMAIL_UYGULAMA_SIFRESI
SMTP_FROM_EMAIL=noreply@sirketiniz.com

# ── Yapay Zeka API'leri (opsiyonel) ──────────────────────────────────────────
GEMINI_API_KEY=GOOGLE_AI_STUDIO_DAN_ALIN
HUGGINGFACE_API_KEY=HUGGINGFACE_TOKEN

# ── Arıza Bildirimleri ────────────────────────────────────────────────────────
ARIZA_TEAM_WHATSAPP=905XXXXXXXXX
ARIZA_TEAM_EMAILS=ekip@sirketiniz.com