ENV={development | production}
PORT=3000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium # e.g. C:\Program Files\Google\Chrome\Application\chrome.exe (Windows) or /usr/bin/google-chrome-stable (Linux) or /Applications/Google Chrome.app/Contents/MacOS/Google Chrome (Mac)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
JWT_SECRET=secret
MONGODB_URI=mongodb://localhost:27017/WhatsYpzck

# Lisanslama
# true ise lisans dosyasi zorunlu olur
LICENSE_ENFORCEMENT=true
# true ise lisans dosyasi olmadan calisabilir (lisanssiz paket icin)
LICENSE_ALLOW_UNLICENSED=false
# Lisans dosyasi yolu
LICENSE_FILE_PATH=licenses/license.key.json
# Public key yolu (license imza dogrulamasi)
LICENSE_PUBLIC_KEY_PATH=licenses/public.pem

# AI API Keys
# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gemini API Key (Google) - https://makersuite.google.com/app/apikey
# Bu key WhatsApp komutları için kişiselleştirilmiş mesajlar oluşturmak için kullanılır
GEMINI_API_KEY=AIzaSy...

# ChatGPT API Key
CHAT_GPT_API_KEY=sk-...

# Web lookup (RAG) ayarlari
# SERPER API Key: https://serper.dev (Google web aramasi)
SERPER_API_KEY=
# true ise web arama baglami aktif olur
AI_WEB_LOOKUP_ENABLED=false
# off | cautious | aggressive
AI_WEB_LOOKUP_MODE=off
# Web arama istek timeout suresi (ms)
WEB_LOOKUP_TIMEOUT_MS=5000
# Web baglam cache suresi (ms) - varsayilan 6 saat
WEB_LOOKUP_CACHE_TTL_MS=21600000
# Sadece bu alan adlarindan gelen kaynaklar kullanilir (virgulle ayirin)
AI_WEB_ALLOWED_DOMAINS=wikipedia.org,gov.tr,edu.tr,resmigazete.gov.tr,epdk.gov.tr,enerji.gov.tr,duckduckgo.com

# Ollama / model ayarlari
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=turkce-sabit-lite-v2:latest
OLLAMA_TIMEOUT_MS=90000
OLLAMA_NUM_PREDICT=72
OLLAMA_NUM_CTX=768
# GPU icin >=0 deger girin (ornek: 1), CPU icin -1 birakin
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_THREAD=8

# AI yogunluk ve hibrit yanit ayarlari
AI_MAX_CONCURRENCY=4
AI_MAX_QUEUE_SIZE=120
AI_HYBRID_ENABLED=true
AI_HYBRID_TRIGGER_INFLIGHT=3
AI_HYBRID_TRIGGER_QUEUE=1
AI_REPLY_CACHE_TTL_MS=45000
AI_MEMORY_CACHE_TTL_MS=15000

# Weather API - OpenWeatherMap
# API Key: https://openweathermap.org/api
# Konum hava durumu bilgisi için kullanılır
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
