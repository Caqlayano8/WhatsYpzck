{
    "name": "WhatsYpzck",
    "version": "2.0.0",
    "description": "Advanced WhatsApp bot with AI integration, location detection, and real-time weather. Built with Node.js, TypeScript, Gemini & ChatGPT APIs.",
    "main": "src/index.ts",
    "dependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@google/generative-ai": "^0.12.0",
        "@iamtraction/google-translate": "^2.0.1",
        "@types/cors": "^2.8.19",
        "@types/multer": "^2.1.0",
        "@types/nodemailer": "^7.0.11",
        "@types/qrcode": "^1.5.6",
        "@types/speakeasy": "^2.0.10",
        "axios": "^1.12.0",
        "bcrypt": "^6.0.0",
        "btch-downloader": "^4.0.15",
        "cheerio": "^1.1.0",
        "cors": "^2.8.6",
        "cron": "^4.3.1",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "esbuild": "^0.25.0",
        "exceljs": "^4.4.0",
        "exifr": "^7.1.3",
        "express": "^4.21.1",
        "express-rate-limit": "^8.3.1",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^8.1.0",
        "husky": "^9.1.6",
        "jsonwebtoken": "^9.0.2",
        "langdetect": "^0.2.1",
        "mongoose": "^8.16.2",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.1",
        "nodemon": "^3.1.4",
        "openai": "^4.48.2",
        "puppeteer": "^22.11.2",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "sherpa-onnx-node": "^1.12.28",
        "speakeasy": "^2.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5",
        "whatsapp-web.js": "^1.34.6",
        "winston": "^3.13.0",
        "wwebjs-mongo": "^1.1.0",
        "yt-dlp-wrap": "^2.3.12"
    },
    "scripts": {
        "start": "ts-node --files src/index.ts",
        "dev": "nodemon --exec \"ts-node --files\" src/index.ts",
        "dev:refresh": "npm run clean:all && npm install && npm run dev",
        "create-admin": "ts-node scripts/create-admin.ts",
        "smoke:incident": "ts-node --transpile-only scripts/incident-flow-smoke.ts",
        "bench:ai": "ts-node scripts/load/benchmark-ai-throughput.ts",
        "license:keypair": "ts-node scripts/license/generate-keypair.ts",
        "license:generate": "ts-node scripts/license/generate-license.ts",
        "license:app": "powershell -ExecutionPolicy Bypass -File scripts/windows/license-generator-app.ps1",
        "license:app:exe": "powershell -ExecutionPolicy Bypass -File scripts/windows/build-license-generator-exe.ps1",
        "report:access-pdf": "node scripts/windows/generate-access-summary-pdf.cjs",
        "build:installers": "powershell -ExecutionPolicy Bypass -File scripts/windows/build-installers.ps1",
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "rimraf build && node esbuild.config.js && npm run copy-files",
        "deploy": "node ./index.js",
        "type-check": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows/setup-whatsypzck.ps1",
        "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows/start-whatsypzck.ps1",
        "clean": "rimraf build",
        "clean:all": "rimraf build && rimraf node_modules",
        "prepare": "husky install",
        "copy-files": "copyfiles -u 0 ./package.json ./.env ./package-lock.json public/**/* build && copyfiles -u 1 src/views/**/* build",
        "pm2:start": "npm run build && pm2 start ecosystem.config.js",
        "pm2:stop": "pm2 stop WhatsYpzck",
        "pm2:restart": "pm2 restart WhatsYpzck",
        "pm2:reload": "npm run build && pm2 reload ecosystem.config.js",
        "pm2:logs": "pm2 logs WhatsYpzck",
        "pm2:monitor": "pm2 monit",
        "pm2:delete": "pm2 delete WhatsYpzck"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CaqlayanKurtoglu/WhatsYpzck.git"
    },
    "keywords": [
        "Polyglot",
        "Whatsapp",
        "Google Traduction",
        "QrCode",
        "Puppeteer",
        "NodeJS",
        "TypeScript",
        "AI",
        "Whatsapp Bot",
        "Automated",
        "Whatsapp",
        "Bot",
        "Gemini",
        "ChatGPT"
    ],
    "author": "Ç.Kurtoğlu",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/CaqlayanKurtoglu/WhatsYpzck/issues"
    },
    "homepage": "https://github.com/CaqlayanKurtoglu/WhatsYpzck#readme",
    "devDependencies": {
        "@types/cron": "^2.0.1",
        "@typescript-eslint/eslint-plugin": "^8.28.0",
        "@typescript-eslint/parser": "^8.28.0",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.22.0",
        "rimraf": "^6.0.1"
    }
}
