<!-- Message Modal -->
<div id="message-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div class="modal-backdrop absolute inset-0" onclick="closeMessageModal()"></div>
  <div class="modal-box relative bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <div><h2 class="text-lg font-bold text-gray-900">Send Message</h2><div class="text-xs text-gray-400 mt-0.5" id="msg-recipient-label">—</div></div>
      <button onclick="closeMessageModal()" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg"><i class="fas fa-times"></i></button>
    </div>
    <div class="p-6"><textarea id="message-content" rows="5" placeholder="Write your message here…" class="field resize-none"></textarea></div>
    <div class="px-6 py-3.5 border-t border-gray-100 bg-gray-50 flex justify-end gap-2">
      <button onclick="closeMessageModal()" class="text-sm text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-white font-medium">Iptal</button>
      <button onclick="sendPrivateMessage()" class="flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-xl text-sm font-semibold"><i class="fas fa-paper-plane text-xs"></i> Send</button>
    </div>
  </div>
</div>

<!-- Revision History Modal -->
<div id="revision-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div class="modal-backdrop absolute inset-0" onclick="closeRevisionModal()"></div>
  <div class="modal-box relative bg-white rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden" style="max-height:80vh;display:flex;flex-direction:column;">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 flex-shrink-0">
      <h2 class="text-lg font-bold text-gray-900">Revision History — <span id="revision-template-name" class="text-indigo-600"></span></h2>
      <button onclick="closeRevisionModal()" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg"><i class="fas fa-times"></i></button>
    </div>
    <div class="overflow-y-auto flex-grow">
      <table class="w-full text-left"><thead><tr class="border-b border-gray-100 bg-gray-50">
        <th class="px-5 py-3 text-xs font-semibold text-gray-500">Rev</th>
        <th class="px-5 py-3 text-xs font-semibold text-gray-500">Saved By</th>
        <th class="px-5 py-3 text-xs font-semibold text-gray-500">Date</th>
        <th class="px-5 py-3 text-xs font-semibold text-gray-500">Preview</th>
        <th class="px-5 py-3 text-xs font-semibold text-gray-500"></th>
      </tr></thead><tbody id="revision-list-body"></tbody></table>
    </div>
    <div class="px-6 py-3 border-t border-gray-100 bg-gray-50 flex justify-end">
      <button onclick="closeRevisionModal()" class="text-sm text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-white font-medium">Close</button>
    </div>
  </div>
</div>

<!-- Template Live Preview Modal -->
<div id="template-preview-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div class="modal-backdrop absolute inset-0" onclick="closeTemplatePreviewModal()"></div>
  <div class="modal-box relative bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900">Live Preview</h2>
      <button onclick="closeTemplatePreviewModal()" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg"><i class="fas fa-times"></i></button>
    </div>
    <div class="p-5 space-y-4">
      <div class="grid grid-cols-3 gap-3">
        <div><label class="text-xs font-semibold text-gray-500 block mb-1">Ad</label><input id="preview-sample-name" type="text" class="field py-1.5 text-sm" placeholder="Alice" oninput="updateTemplatePreview()"></div>
        <div><label class="text-xs font-semibold text-gray-500 block mb-1">Telefon</label><input id="preview-sample-phone" type="text" class="field py-1.5 text-sm" placeholder="123456789" oninput="updateTemplatePreview()"></div>
        <div><label class="text-xs font-semibold text-gray-500 block mb-1">Date</label><input id="preview-sample-date" type="text" class="field py-1.5 text-sm" placeholder="Today" oninput="updateTemplatePreview()"></div>
      </div>
      <div><div class="text-xs font-semibold text-gray-500 mb-2">Rendered output</div><div class="wa-bg"><div class="wa-bubble whitespace-pre-wrap" id="template-preview-output">…</div></div></div>
    </div>
    <div class="px-6 py-3 border-t border-gray-100 bg-gray-50 flex justify-end">
      <button onclick="closeTemplatePreviewModal()" class="text-sm text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-white font-medium">Close</button>
    </div>
  </div>
</div>

<!-- Scheduled Message Modal -->
<div id="scheduled-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div class="modal-backdrop absolute inset-0" onclick="closeScheduledModal()"></div>
  <div class="modal-box relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900">Yeni Zamanlanmis Mesaj</h2>
      <button onclick="closeScheduledModal()" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg"><i class="fas fa-times"></i></button>
    </div>
    <div class="p-6 space-y-4">
      <div>
        <label class="text-xs font-semibold text-gray-500 block mb-1">Alici Telefonu *</label>
        <div class="flex gap-2">
          <input id="sched-phone" class="field flex-grow" placeholder="e.g. 22890123456">
          <button type="button" onclick="openScheduledContactPicker()" class="text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-3 py-2 rounded-xl font-semibold flex-shrink-0"><i class="fas fa-address-book"></i></button>
        </div>
        <div id="sched-contact-name" class="text-xs text-green-600 mt-1 hidden"></div>
      </div>
      <div><label class="text-xs font-semibold text-gray-500 block mb-1">Mesaj *</label><textarea id="sched-message" rows="4" class="field resize-none" placeholder="Mesajinizi yazin..."></textarea></div>
      <div><label class="text-xs font-semibold text-gray-500 block mb-1">Gonderim Zamani *</label><input type="datetime-local" id="sched-at" class="field"></div>
    </div>
    <div class="px-6 py-3.5 border-t border-gray-100 bg-gray-50 flex justify-end gap-2">
      <button onclick="closeScheduledModal()" class="text-sm text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-white font-medium">Iptal</button>
      <button onclick="saveScheduledMessage()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-xl text-sm font-semibold"><i class="fas fa-clock text-xs mr-1.5"></i>Zamanla</button>
    </div>
  </div>
</div>

