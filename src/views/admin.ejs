    <div class="grid grid-cols-4 gap-4 mb-5">
      <div class="stat-card"><div class="text-2xl font-bold text-gray-900" id="total-contacts">—</div><div class="text-xs text-gray-500 mt-1 font-medium">Toplam Kisi</div><div id="contacts-delta" class="text-xs mt-1 hidden"></div></div>
