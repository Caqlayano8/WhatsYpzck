        <div class="flex items-center gap-3">
          <div class="toggle-track on" id="ar-enabled-toggle" onclick="toggleArEtkin()" title="Etkin"></div>
          <span class="text-sm text-gray-600">Etkin</span>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
