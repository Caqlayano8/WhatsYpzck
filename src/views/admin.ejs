  <div class="modal-backdrop absolute inset-0" onclick="closeCampaignModal()"></div>
  <div class="modal-box relative bg-white rounded-2xl shadow-2xl w-full overflow-hidden" style="max-width:960px;max-height:92vh;display:flex;flex-direction:column;">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 flex-shrink-0">
      <h2 id="campaign-modal-title" class="text-lg font-bold text-gray-900">Yeni Kampanya</h2>
      <button onclick="closeCampaignModal()" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg"><i class="fas fa-times"></i></button>
    </div>
    <div class="flex border-b border-gray-100 flex-shrink-0">
      <div class="ctab active" id="ctab-compose" onclick="switchCampaignTab('compose')"><i class="fas fa-pen-to-square mr-1.5 text-xs"></i>Oluştur</div>
      <div class="ctab" id="ctab-recipients" onclick="switchCampaignTab('recipients')"><i class="fas fa-users mr-1.5 text-xs"></i>Alicilar</div>
      <div class="ctab" id="ctab-schedule" onclick="switchCampaignTab('schedule')"><i class="fas fa-clock mr-1.5 text-xs"></i>Zamanlama ve Gönderme</div>
    </div>
    <div class="overflow-y-auto flex-grow">
      <div id="ctab-compose-content" class="p-6">
        <div class="grid gap-5" style="grid-template-columns:1fr 1fr;">
          <div class="space-y-4">
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Kampanya Adı *</label><input id="campaign-name" class="field" placeholder="Örn. Haftalık Promosyon" oninput="updateWaPreview();updateScheduleSummary()"></div>
            <div>
              <div class="flex items-center justify-between mb-1"><label class="text-xs font-semibold text-gray-500">Mesaj *</label><span class="text-xs text-gray-400" id="msg-char-count">0 karakter</span></div>
              <div class="flex gap-1.5 mb-2 flex-wrap">
                <button type="button" onclick="insertVariable('{{name}}')" class="text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-lg font-semibold">{{name}}</button>
                <button type="button" onclick="insertVariable('{{phone}}')" class="text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-lg font-semibold">{{phone}}</button>
                <button type="button" onclick="insertVariable('{{date}}')" class="text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-lg font-semibold">{{date}}</button>
              </div>
              <textarea id="campaign-message" rows="7" class="field resize-none" placeholder="Mesajinizi yazin..." oninput="updateWaPreview()"></textarea>
            </div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Şablon Kullan</label><select id="template-selector" onchange="applyTemplateToModal()" class="field"><option value="">— Bir sablon secin —</option></select></div>
            <div>
              <label class="text-xs font-semibold text-gray-500 block mb-1">Medya Eki (isteğe bağlı)</label>
              <div class="flex gap-2 items-center">
                <input id="campaign-media-url" class="field text-xs" placeholder="Resim / video URL yapıştırın…" oninput="updateMediaPreview()">
                <button type="button" onclick="document.getElementById('campaign-media-url').value='';updateMediaPreview()" class="text-gray-400 hover:text-red-500 flex-shrink-0" title="Clear"><i class="fas fa-times"></i></button>
              </div>
              <div id="media-preview-wrap" class="hidden mt-2"><img id="media-preview-img" src="" alt="preview" class="max-h-24 rounded-lg border border-gray-200 object-contain"></div>
              <p class="text-xs text-gray-400 mt-1">Desteklenen: resim (jpg/png/gif/webp), video (mp4), belge (pdf). Doğrudan genel URL olmalıdır.</p>
            </div>
          </div>
          <div><div class="text-xs font-semibold text-gray-500 mb-2">Önizleme</div><div class="wa-bg"><div class="wa-bubble" id="wa-preview">Mesajınız burada görünecek…</div></div></div>
        </div>
      </div>
      <div id="ctab-recipients-content" class="p-6 hidden">
        <div class="grid gap-4" style="grid-template-columns:1fr 1fr;">
          <div>
            <div class="text-xs font-semibold text-gray-500 mb-2">Mevcut Kisiler</div>
            <div class="flex gap-1.5 mb-2 flex-wrap">
              <button type="button" onclick="selectAllContacts()" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-2.5 py-1 rounded-lg font-semibold">Tumü</button>
              <button type="button" onclick="selectEnglishSpeakers()" class="text-xs bg-green-50 hover:bg-green-100 text-green-700 px-2.5 py-1 rounded-lg font-semibold">🇬🇧 English</button>
              <button type="button" onclick="selectFrenchSpeakers()" class="text-xs bg-purple-50 hover:bg-purple-100 text-purple-700 px-2.5 py-1 rounded-lg font-semibold">🇫🇷 French</button>
              <button type="button" onclick="deselectAllContacts()" class="text-xs bg-red-50 hover:bg-red-100 text-red-700 px-2.5 py-1 rounded-lg font-semibold ml-auto">Temizle</button>
            </div>
            <input type="text" id="recipient-search" placeholder="Kisileri filtrele..." class="field mb-2 py-2" style="font-size:0.8rem;" oninput="filterAvailableContacts(this.value)">
            <div id="available-contacts-list" class="border border-gray-200 rounded-xl overflow-y-auto" style="height:320px;"></div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="text-xs font-semibold text-gray-500">Selected (<span id="selected-count">0</span>)</div>
            </div>
            <div class="mb-2"><input type="text" id="csv-recipients" placeholder="Veya telefon numaralarini virgul ile ayirarak yapistirin" class="field py-1.5" style="font-size:0.75rem;" oninput="parseCsvAlicilar(this.value)"></div>
            <div id="selected-contacts-list" class="border border-gray-200 rounded-xl p-2 overflow-y-auto space-y-1.5" style="height:340px;"></div>
          </div>
        </div>
      </div>
      <div id="ctab-schedule-content" class="p-6 hidden">
        <div class="grid gap-6" style="grid-template-columns:1fr 1fr;">
          <div class="space-y-4">
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm space-y-2">
              <div class="flex justify-between"><span class="text-gray-500">Campaign</span><span class="font-semibold text-gray-800" id="summary-name">—</span></div>
              <div class="flex justify-between"><span class="text-gray-500">Alicilar</span><span class="font-semibold text-gray-800"><span id="summary-recipients">0</span> kisi</span></div>
              <div class="flex justify-between"><span class="text-gray-500">Mesaj uzunluğu</span><span class="font-semibold text-gray-800" id="summary-length">0 karakter</span></div>
              <div class="flex justify-between"><span class="text-gray-500">Gönderim</span><span class="font-semibold text-gray-800" id="summary-delivery">Hemen</span></div>
              <div class="flex justify-between"><span class="text-gray-500">Tekrarlayan</span><span class="font-semibold text-gray-800" id="summary-recurring">Yok</span></div>
            </div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Sonraya planla (isteğe bağlı)</label><input type="datetime-local" id="campaign-scheduledAt" class="field" onchange="updateScheduleSummary()"></div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Tekrarlayan</label>
              <select id="campaign-recurringType" class="field" onchange="updateRecurringUI()">
                <option value="none">Yok (bir kez gönder)</option>
                <option value="daily">Günlük</option>
                <option value="weekly">Haftalık</option>
                <option value="monthly">Aylık</option>
              </select>
            </div>
            <div id="recurring-day-wrap" class="hidden">
              <label class="text-xs font-semibold text-gray-500 block mb-1" id="recurring-day-label">Day</label>
              <input type="number" id="campaign-recurringDay" class="field" style="max-width:120px;" min="0" max="31">
            </div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Kısıtlama Hızı (mesaj/dk)</label><input type="number" id="campaign-throttle" class="field" style="max-width:120px;" min="1" max="600" value="60"></div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Son Kullanma Tarihi (isteğe bağlı)</label><input type="datetime-local" id="campaign-expires" class="field"></div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Etiketleri Dışla (virgülle ayrılmış)</label><input type="text" id="campaign-exclude-tags" class="field" placeholder="Örn. vip, çıktı"></div>
            <div><label class="text-xs font-semibold text-gray-500 block mb-1">Kampanya Notları</label><textarea id="campaign-notes" rows="2" class="field resize-none" placeholder="Dahili notlar…"></textarea></div>
          </div>
          <div class="space-y-4">
            <div><div class="text-xs font-semibold text-gray-500 mb-2">Önizleme</div><div class="wa-bg"><div class="wa-bubble" id="wa-preview-2">Mesajınız burada görünecek…</div></div></div>
            <div class="border border-gray-200 rounded-xl p-4 space-y-3">
              <div class="flex items-center gap-2"><label class="text-xs font-semibold text-gray-600">A/B Test</label><input type="checkbox" id="ab-test-toggle" onchange="toggleAbTest()" class="rounded"></div>
              <div id="ab-test-wrap" class="hidden"><label class="text-xs font-semibold text-gray-500 block mb-1">Variant B Message</label><textarea id="campaign-variant-b" rows="4" class="field resize-none text-xs" placeholder="Alternate message for odd-indexed kisi…"></textarea></div>
            </div>
        </div>
      </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-between items-center flex-shrink-0">
      <button id="campaign-back-btn" onclick="advanceCampaignTab(-1)" class="hidden text-sm text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-white font-medium"><i class="fas fa-arrow-left text-xs mr-1.5"></i>Back</button>
      <div class="ml-auto flex gap-2">
        <button onclick="closeCampaignModal()" class="text-sm text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-white font-medium">Iptal</button>
        <button id="campaign-next-btn" onclick="advanceCampaignTab(1)" class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-xl text-sm font-semibold">Next <i class="fas fa-arrow-right text-xs"></i></button>
        <button id="campaign-send-btn" onclick="submitCampaign()" class="hidden flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-xl text-sm font-semibold"><i class="fas fa-paper-plane text-xs"></i> Send Campaign</button>
      </div>
    </div>
  </div>
</div>

