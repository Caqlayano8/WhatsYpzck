        <div id="top-commands-widget" class="p-4 text-sm text-gray-400 italic">Yukleniyor...</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="px-5 py-3.5 border-b border-gray-100 flex items-center justify-between"><h2 class="font-semibold text-gray-900 text-sm">Son Etkinlik</h2><span class="text-xs text-gray-400">Denetim kaydi</span></div>
        <div id="recent-audit-widget" class="p-4 text-sm text-gray-400 italic">Yukleniyor...</div>
      </div>
    </div>
    <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100"><h2 class="font-semibold text-gray-900 text-sm">Son Kisiler</h2></div>
      <table class="w-full text-left"><thead><tr class="border-b border-gray-100 bg-gray-50"><th class="px-6 py-3 text-xs font-semibold text-gray-500">Ad</th><th class="px-6 py-3 text-xs font-semibold text-gray-500">Telefon</th><th class="px-6 py-3 text-xs font-semibold text-gray-500">Dil</th><th class="px-6 py-3 text-xs font-semibold text-gray-500">Son gorulme</th></tr></thead><tbody id="recent-contacts"></tbody></table>
    </div>
  </div>

  <!-- Contacts -->
  <div id="contacts-section" class="section-content p-6">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-2xl font-bold text-gray-900">Kisiler</h1><p class="text-sm text-gray-500 mt-0.5">Bot ile etkilesime giren kisiler</p></div>
      <div class="flex items-center gap-2">
        <button onclick="openImportModal()" class="flex items-center gap-1.5 text-sm text-gray-600 border border-gray-200 bg-white hover:bg-gray-50 px-3 py-2 rounded-xl font-medium transition-colors"><i class="fas fa-file-import text-xs"></i> CSV Ice Aktar</button>
        <button onclick="exportContacts()" class="flex items-center gap-1.5 text-sm text-gray-600 border border-gray-200 bg-white hover:bg-gray-50 px-3 py-2 rounded-xl font-medium transition-colors"><i class="fas fa-file-export text-xs"></i> CSV Disa Aktar</button>
