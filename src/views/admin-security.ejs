<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsYpzck Guvenlik Ayarlari</title>
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
  <link rel="icon" href="/public/favicon.png">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="bg-slate-100 min-h-screen">
  <div class="max-w-2xl mx-auto p-4 sm:p-6">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-shield-alt text-indigo-600"></i>
          </div>
          <div>
            <h1 class="text-base font-semibold text-slate-800">Guvenlik Ayarlari</h1>
            <p id="sec-username-label" class="text-xs text-slate-500"></p>
          </div>
        </div>
        <a href="/admin" class="text-sm text-indigo-600 hover:text-indigo-700 font-medium">
          <i class="fas fa-arrow-left mr-1"></i> Panele Don
        </a>
      </div>

      <div class="p-5 space-y-4">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <div>
              <p class="text-sm font-semibold text-slate-800">Iki Adimli Dogrulama (2FA)</p>
              <p id="sec-2fa-desc" class="text-xs text-slate-500">Giriste e-postaniza kod gonderilir</p>
            </div>
            <label class="relative inline-block w-11 h-6 cursor-pointer">
              <input type="checkbox" id="sec-2fa-toggle" class="opacity-0 w-0 h-0" onchange="onTwoFaToggle(this.checked)">
              <span id="sec-2fa-slider" class="absolute inset-0 bg-gray-300 rounded-full transition"></span>
              <span id="sec-2fa-knob" class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full transition shadow"></span>
            </label>
          </div>

          <div id="sec-email-row" class="hidden mt-3">
            <label class="text-xs font-semibold text-slate-600 block mb-1">E-posta Adresi</label>
            <input id="sec-email-input" type="email" placeholder="ornek@mail.com" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400">
          </div>

          <div id="sec-2fa-method-row" class="hidden mt-3">
            <label class="text-xs font-semibold text-slate-600 block mb-2">Dogrulama Yontemi</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label class="flex items-center gap-2 text-xs border border-slate-300 rounded-lg px-3 py-2 cursor-pointer">
                <input type="radio" name="sec-2fa-method" value="email" id="sec-method-email" onchange="onMethodChange('email')" checked> E-posta OTP
              </label>
              <label class="flex items-center gap-2 text-xs border border-slate-300 rounded-lg px-3 py-2 cursor-pointer">
                <input type="radio" name="sec-2fa-method" value="totp" id="sec-method-totp" onchange="onMethodChange('totp')"> Google Authenticator
              </label>
            </div>
          </div>

          <div id="sec-totp-row" class="hidden mt-4 text-center">
            <p class="text-xs text-slate-600 mb-2">Authenticator ile QR kodu okutun:</p>
            <img id="sec-totp-qr" src="" alt="QR" class="w-40 h-40 mx-auto border border-slate-200 rounded-lg">
            <input id="sec-totp-code" type="text" maxlength="6" placeholder="6 haneli kod" class="mt-3 w-40 border border-slate-300 rounded-lg px-3 py-2 text-center text-lg tracking-widest outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400">
            <button onclick="activateTotp()" class="mt-2 px-4 py-2 text-xs font-semibold bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Etkinlestir</button>
            <p id="sec-totp-msg" class="text-xs mt-2 hidden"></p>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <p class="text-sm font-semibold text-slate-800 mb-2">Sifre Degistir</p>
          <div class="space-y-2">
            <input id="sec-old-pw" type="password" placeholder="Mevcut sifre" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400">
            <input id="sec-new-pw" type="password" placeholder="Yeni sifre (min 6 karakter)" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400">
          </div>
        </div>

        <p id="sec-msg" class="text-sm text-center min-h-[20px]"></p>
        <button onclick="saveSecuritySettings()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg py-2.5 text-sm font-semibold">Kaydet</button>
      </div>
    </div>
  </div>

<script>
const token = localStorage.getItem('token');
if (!token) window.location.href = '/admin/login';

function updateToggleUI(on) {
  const slider = document.getElementById('sec-2fa-slider');
  const knob = document.getElementById('sec-2fa-knob');
  const emailRow = document.getElementById('sec-email-row');
  slider.style.background = on ? '#4f46e5' : '#d1d5db';
  knob.style.transform = on ? 'translateX(20px)' : 'translateX(0)';
  emailRow.classList.toggle('hidden', !on);
}

function onTwoFaToggle(checked) {
  updateToggleUI(checked);
  document.getElementById('sec-2fa-method-row').classList.toggle('hidden', !checked);
  if (!checked) onMethodChange('email');
}

function onMethodChange(method) {
  const emailRow = document.getElementById('sec-email-row');
  const totpRow = document.getElementById('sec-totp-row');
  const desc = document.getElementById('sec-2fa-desc');
  if (method === 'totp') {
    emailRow.classList.add('hidden');
    totpRow.classList.remove('hidden');
    desc.textContent = 'Giriste Google Authenticator kodu istenir';
    if (!document.getElementById('sec-totp-qr').src) loadTotpQr();
  } else {
    emailRow.classList.remove('hidden');
    totpRow.classList.add('hidden');
    desc.textContent = 'Giriste e-postaniza kod gonderilir';
  }
}

async function loadTotpQr() {
  const res = await fetch('/crm/auth/2fa/totp-setup', { method: 'POST', headers: { Authorization: 'Bearer ' + token } });
  if (!res.ok) return;
  const data = await res.json();
  document.getElementById('sec-totp-qr').src = data.qrCodeDataUrl || '';
}

async function activateTotp() {
  const code = document.getElementById('sec-totp-code').value.trim();
  const msg = document.getElementById('sec-totp-msg');
  if (!code || code.length !== 6) {
    msg.classList.remove('hidden');
    msg.className = 'text-xs mt-2 text-red-600';
    msg.textContent = '6 haneli kod girin.';
    return;
  }
  const res = await fetch('/crm/auth/2fa/totp-activate', {
    method: 'POST',
    headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
    body: JSON.stringify({ token: code })
  });
  const data = await res.json();
  msg.classList.remove('hidden');
  if (res.ok) {
    msg.className = 'text-xs mt-2 text-green-600';
    msg.textContent = 'Google Authenticator etkinlestirildi.';
  } else {
    msg.className = 'text-xs mt-2 text-red-600';
    msg.textContent = data.error || 'Hata.';
  }
}

async function saveSecuritySettings() {
  const msg = document.getElementById('sec-msg');
  msg.className = 'text-sm text-center text-slate-500';
  msg.textContent = 'Kaydediliyor...';

  const twoFaEnabled = document.getElementById('sec-2fa-toggle').checked;
  const email = document.getElementById('sec-email-input').value.trim();
  const oldPw = document.getElementById('sec-old-pw').value;
  const newPw = document.getElementById('sec-new-pw').value;

  if (twoFaEnabled && !email && !document.getElementById('sec-method-totp').checked) {
    msg.className = 'text-sm text-center text-red-600';
    msg.textContent = '2FA icin e-posta girin.';
    return;
  }

  try {
    const r2fa = await fetch('/crm/auth/2fa/setup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ enabled: twoFaEnabled, email: twoFaEnabled ? email : undefined }),
    });
    const d2fa = await r2fa.json();
    if (!r2fa.ok) throw new Error(d2fa.error || '2FA ayarlanamadi.');

    if (oldPw && newPw) {
      if (newPw.length < 6) throw new Error('Yeni sifre en az 6 karakter olmali.');
      const rpw = await fetch('/crm/users/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ oldPassword: oldPw, newPassword: newPw }),
      });
      const dpw = await rpw.json();
      if (!rpw.ok) throw new Error(dpw.error || 'Sifre degistirilemedi.');
    }

    msg.className = 'text-sm text-center text-green-600';
    msg.textContent = 'Ayarlar kaydedildi.';
    document.getElementById('sec-old-pw').value = '';
    document.getElementById('sec-new-pw').value = '';
  } catch (err) {
    msg.className = 'text-sm text-center text-red-600';
    msg.textContent = err.message;
  }
}

(async function initSecurityPage() {
  try {
    const r = await fetch('/crm/auth/check', { headers: { Authorization: 'Bearer ' + token } });
    if (!r.ok) {
      localStorage.removeItem('token');
      window.location.href = '/admin/login';
      return;
    }
    const data = await r.json();
    const u = data.user || {};
    document.getElementById('sec-username-label').textContent = '@' + (u.username || '');
    const on = !!u.twoFactorEnabled;
    document.getElementById('sec-2fa-toggle').checked = on;
    updateToggleUI(on);
    document.getElementById('sec-2fa-method-row').classList.toggle('hidden', !on);
    if (u.email) document.getElementById('sec-email-input').value = u.email;
    if (u.twoFactorMethod === 'totp') {
      document.getElementById('sec-method-totp').checked = true;
      onMethodChange('totp');
    }
  } catch {
    localStorage.removeItem('token');
    window.location.href = '/admin/login';
  }
})();
</script>
</body>
</html>
